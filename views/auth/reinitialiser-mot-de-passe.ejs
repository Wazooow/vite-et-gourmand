<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include("../partials/head", { title: "Nouveau mot de passe" }) %>
</head>
<body>
  <%- include("../partials/header") %>
  <main>
    <h1>Choisir un nouveau mot de passe</h1>
    <%- include("../partials/messages", { erreurs: erreurs }) %>

    <form method="POST" action="/auth/reinitialiser-mot-de-passe/<%= token %>" class="form">
      <label>Nouveau mot de passe
        <input type="password" name="password" required minlength="10">
      </label>
      <label>Confirmer le mot de passe
        <input type="password" name="password_confirmation" required minlength="10">
      </label>
      <p class="hint">10 caractères minimum, avec au moins une majuscule, une minuscule, un chiffre et un caractère spécial.</p>
      <button type="submit">Valider</button>
    </form>
  </main>
  <%- include("../partials/footer") %>
</body>
</html>
