<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include("../partials/head", { title: "Modérer les avis" }) %>
</head>
<body>
  <%- include("../partials/header") %>
  <main>
    <h1>Avis clients</h1>
    <%- include("../partials/messages", {}) %>

    <table class="tableau">
      <thead><tr><th>Client</th><th>Commande</th><th>Note</th><th>Commentaire</th><th>Statut</th><th></th></tr></thead>
      <tbody>
        <% avis.forEach(function(a) { %>
          <tr>
            <td><%= a.prenom %> <%= a.nom %></td>
            <td><%= a.numero_commande %></td>
            <td><%= "★".repeat(a.note) %></td>
            <td><%= a.description %></td>
            <td><%= a.statut %></td>
            <td>
              <% if (a.statut === "en_attente") { %>
                <form method="POST" action="/employe/avis/<%= a.avis_id %>/valider" style="display:inline">
                  <button type="submit">Valider</button>
                </form>
                <form method="POST" action="/employe/avis/<%= a.avis_id %>/refuser" style="display:inline">
                  <button type="submit">Refuser</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
  <%- include("../partials/footer") %>
</body>
</html>
